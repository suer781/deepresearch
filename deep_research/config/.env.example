# Deep Research 配置示例 - 复制为 .env 填入

# ==========================
# 模式选择（二选一）
# ==========================
# 本地部署（推荐：Ollama / LM Studio / vLLM 等 OpenAI 兼容服务）
# 打开后会自动切换到本地 LLM + 免 API key 搜索源
DR_USE_LOCAL_MODEL=true
# Ollama 默认: http://localhost:11434/v1
# LM Studio 默认: http://localhost:1234/v1
# vLLM 默认: http://localhost:8000/v1
DR_LOCAL_MODEL_URL=http://localhost:11434/v1
# Ollama 模型名：qwen3:8b / deepseek-r1:14b / llama3.3:70b / phi4 等
DR_LOCAL_MODEL_NAME=qwen3:8b

# 云端部署（需要 API key）
# DR_OPENAI_API_KEY=sk-...
# DR_OPENAI_BASE_URL=https://api.openai.com/v1
# DR_PRIMARY_MODEL=gpt-4o
# DR_DEBATER_MODEL=gpt-4o-mini
# DR_CRITIC_MODEL=gpt-4o-mini

# ==========================
# 搜索 API —— 填了就用，没填自动跳过
# ==========================
DR_TAVILY_API_KEY=
DR_BRAVE_API_KEY=
DR_EXA_API_KEY=
DR_SERLO_API_KEY=
DR_PARALLEL_API_KEY=
DR_SERPAPI_API_KEY=
DR_SERPER_API_KEY=

# 国内搜索 API
DR_ZHIHU_API_KEY=
DR_ALIYUN_SEARCH_API_KEY=
DR_ALIYUN_SEARCH_HOST=
DR_TIKHUB_API_KEY=

# ==========================
# 抓取 & 运行时
# ==========================
DR_PLAYWRIGHT_HEADLESS=true
DR_SCRAPE_RATE_LIMIT_PER_SEC=1.0
DR_PROXY_URL=
DR_MAX_PARALLEL_SUBTASKS=8
DR_MAX_DEBATE_ROUNDS=3
DR_EVIDENCE_PER_SUBTASK=10

# 调试
DR_DEBUG=false
DR_LOG_LEVEL=INFO

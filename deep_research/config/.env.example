# Deep Research 配置示例 - 复制为 .env 填入

# LLM
DR_OPENAI_API_KEY=sk-...
DR_OPENAI_BASE_URL=https://api.openai.com/v1
DR_PRIMARY_MODEL=gpt-4o
DR_DEBATER_MODEL=gpt-4o-mini
DR_CRITIC_MODEL=gpt-4o-mini

# 搜索 API - 国际
DR_TAVILY_API_KEY=
DR_BRAVE_API_KEY=
DR_EXA_API_KEY=
DR_SERLO_API_KEY=
DR_PARALLEL_API_KEY=
DR_SERPAPI_API_KEY=
DR_SERPER_API_KEY=

# 搜索 API - 国内
DR_ZHIHU_API_KEY=
DR_ALIYUN_SEARCH_API_KEY=
DR_ALIYUN_SEARCH_HOST=
DR_TIKHUB_API_KEY=

# 抓取
DR_PLAYWRIGHT_HEADLESS=true
DR_SCRAPE_RATE_LIMIT_PER_SEC=1.0
DR_PROXY_URL=

# 运行时
DR_MAX_PARALLEL_SUBTASKS=8
DR_MAX_DEBATE_ROUNDS=3
DR_EVIDENCE_PER_SUBTASK=10

# 调试
DR_DEBUG=false
DR_LOG_LEVEL=INFO
